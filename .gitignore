# ==============================================================================
# .gitignore - Giàn phơi thông minh IoT
# ==============================================================================

# 1. Biến môi trường & Thông tin bí mật (Secrets & Credentials)
.env
.env.local
.env.*.local
*.env
webapp/.env
firmware/.env
firmware/secrets.py

# File cấu hình chứa mật khẩu WiFi và khóa Firebase
*.ini
config.ini
firmware/config.ini

# Ngoại lệ: Giữ lại các file mẫu cấu hình
!*.example
!*.example.*
!config.ini.example
!firmware/config.ini.example
!webapp/.env.example

# 2. Python & MicroPython
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.temp

# 3. Môi trường phát triển & IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.upycraft/
uPyCraft/
.thonny/

# 4. Tệp hệ thống
.DS_Store
Thumbs.db
desktop.ini

# 5. Khóa xác thực Firebase / Google Admin SDK
*firebase-adminsdk*.json
serviceAccountKey.json
