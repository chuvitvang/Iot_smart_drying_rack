# ==============================================================================
# .gitignore - Giàn phơi thông minh IoT
# ==============================================================================

# 1. Biến môi trường & Thông tin bí mật (Secrets)
.env
.env.local
.env.*.local
*.env
firmware/.env
firmware/secrets.py
!*.example

# 2. Python & MicroPython
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.temp

# 3. Môi trường phát triển & IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.upycraft/
uPyCraft/
.thonny/

# 4. Tệp hệ thống
.DS_Store
Thumbs.db
desktop.ini

# 5. Khóa xác thực Firebase / Google
*firebase-adminsdk*.json
serviceAccountKey.json

