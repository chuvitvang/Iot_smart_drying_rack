# ==============================================================================
# webapp/.env.example - Mẫu cấu hình biến môi trường cục bộ cho Web Dashboard
# Hướng dẫn: Sao chép tệp này thành .env trong thư mục webapp nếu muốn tải tự động
# File webapp/.env sẽ được git tự động bỏ qua để bảo mật API key.
# ==============================================================================

# 1. Khóa API Firebase Web (Lấy từ Firebase Console > Project Settings)
FIREBASE_API_KEY=""

# 2. URL Firebase Realtime Database
FIREBASE_DATABASE_URL="https://your-project-id-default-rtdb.firebaseio.com"

# 3. Mã định danh dự án Firebase
FIREBASE_PROJECT_ID="your-project-id"
