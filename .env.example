# ==============================================================================
# .env.example - Mẫu cấu hình biến môi trường cho Giàn phơi thông minh
# Sao chép tệp này thành .env và điền thông tin thực tế của bạn
# (Tệp .env sẽ được tự động bỏ qua bởi git để bảo mật)
# ==============================================================================

# 1. Cấu hình mạng WiFi gia đình
WIFI_SSID="YOUR_WIFI_SSID"
WIFI_PASSWORD="YOUR_WIFI_PASSWORD"

# 2. Cấu hình Firebase Realtime Database
FIREBASE_URL="https://your-project-id-default-rtdb.firebaseio.com"
FIREBASE_AUTH=""

# 3. Cấu hình GitHub OTA
GITHUB_USER="chuvitvang"
GITHUB_REPO="Iot_smart_drying_rack"
GITHUB_BRANCH="main"
